# ============================================================
#  TaskManager — Angular (Client) + ASP.NET Core (Server)
# ============================================================


# ===========================
#  CLIENT — Angular
# ===========================

Client/node_modules/
Client/dist/
Client/.angular/
Client/.env
Client/.env.local
Client/.env.*.local
Client/coverage/
Client/.nyc_output/
Client/*.js.map
Client/public/            
Client/package-lock.json


# ===========================
#  SERVER — ASP.NET Core
# ===========================

# Build output
Server/*/bin/
Server/*/obj/

# User-specific files
Server/*.user
Server/*.suo
Server/WebApi/.vs/

# Environment / secrets
Server/WebApi/.env
Server/WebApi/.env.local
Server/WebApi/appsettings.*.json
Server/WebApi/appsettings.Local.json
Server/WebApi/secrets.json
Server/WebApi/Properties/launchSettings.json 

# Publish output
Server/WebApi/publish/
Server/WebApi/out/

# Entity Framework migrations (optional — remove if you want to track them)
# Server/Migrations/

# NuGet
Server/.nuget/
Server/packages/
Server/*.nupkg

# ===========================
#  GENERAL
# ===========================


# Editor — VS Code (keep shared settings, ignore personal)
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
!.vscode/launch.json

# Editor — JetBrains / Rider
.idea/
*.iml

# Editor — Visual Studio
*.suo
*.user
*.userosscache
*.sln.docstates
.vs/

# Docker (optional — remove if you want to track these)
# docker-compose.override.yml

# SSL certs / keys
*.pem
*.pfx
*.key
*.crt
*.cer

# VS Code — ignore personal files, keep shared
.vscode/*
!.vscode/extensions.json

Client/.vscode/*
!Client/.vscode/extensions.json